{"id":66,"level":"A2","titleFa":"آینده و پیشنهاد: zullen","sentences":[{"nl":"Ik zal je helpen.","fa":"کمکت خواهم کرد.","notes":["{Zullen} برای قول و آینده. {Helpen} آخر."]},{"nl":"Zal ik het raam opendoen?","fa":"پنجره را باز کنم؟","notes":["{Zal ik}...? برای پیشنهاد کمک."]},{"nl":"Zullen we koffie drinken?","fa":"قهوه بخوریم؟","notes":["{Zullen we}...? یعنی «بیا ... کنیم»."]},{"nl":"Het zal wel goed gaan.","fa":"حتماً خوب پیش می‌رود.","notes":["{Zal wel} یعنی احتمالاً، حتماً."]},{"nl":"We zullen zien.","fa":"خواهیم دید.","notes":["جمله رایج وقتی مطمئن نیستیم."]},{"nl":"Zal ik je morgen bellen?","fa":"فردا بهت زنگ بزنم؟","notes":["پیشنهاد مؤدبانه: {Zal ik} + ... + فعل آخر."]},{"nl":"Ik zal het niet vergeten.","fa":"فراموشش نمی‌کنم.","notes":["قول دادن با {zal}."]},{"nl":"Zullen we om acht uur afspreken?","fa":"ساعت هشت قرار بگذاریم؟","notes":["{Afspreken} یعنی قرار گذاشتن."]},{"nl":"Hij zal wel moe zijn.","fa":"حتماً خسته است.","notes":["حدس زدن با {zal wel}."]},{"nl":"Zal ik iets meenemen?","fa":"چیزی با خودم بیاورم؟","notes":["{Meenemen} یعنی با خود آوردن."]},{"nl":"Wat zullen we vanavond eten?","fa":"امشب چه بخوریم؟","notes":["{Zullen we} در سؤال با {wat}."]}],"reading":[{"nl":"Zullen we zaterdag afspreken?","fa":"شنبه قرار بگذاریم؟"},{"nl":"Goed idee! Zal ik iets meenemen?","fa":"فکر خوبی است! چیزی بیاورم؟"},{"nl":"Ja, neem een taart mee.","fa":"آره، یک کیک بیاور."},{"nl":"Ik zal koffie zetten.","fa":"من قهوه درست می‌کنم."},{"nl":"Het zal vast gezellig worden.","fa":"حتماً خوش می‌گذرد."}],"readingAudio":"audio/r-066.mp3","recap":"{Zal ik}...? برای پیشنهاد کمک. {Zullen we}...? برای «بیا ... کنیم». {zal wel} برای حدس."}