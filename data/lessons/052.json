{"id":52,"level":"A2","titleFa":"داشتم: had، hadden","sentences":[{"nl":"Ik had geen tijd.","fa":"وقت نداشتم.","notes":["{Had} گذشته {hebben} است برای {ik}، {jij}، {hij}، {zij}."]},{"nl":"Hij had een oude auto.","fa":"او یک ماشین قدیمی داشت.","notes":["{Oud} ← {oude}، چون {de auto}."]},{"nl":"We hadden een hond.","fa":"ما یک سگ داشتیم.","notes":["برای جمع: {hadden}."]},{"nl":"Had je honger?","fa":"گرسنه بودی؟","notes":["{Honger hebben} ← {honger had}."]},{"nl":"Ze had hoofdpijn.","fa":"سردرد داشت.","notes":["{Hoofdpijn hebben} ← {hoofdpijn had}."]},{"nl":"Vroeger hadden we een tuin.","fa":"قبلاً باغچه داشتیم.","notes":["{Vroeger} اول، {hadden} دوم."]},{"nl":"Ik had gelijk.","fa":"حق با من بود.","notes":["{Gelijk hebben} یعنی حق داشتن."]},{"nl":"Jullie hadden geluk.","fa":"شانس آوردید.","notes":["{Geluk hebben} یعنی شانس داشتن."]},{"nl":"Hadden ze kinderen?","fa":"بچه داشتند؟","notes":["در سؤال، {hadden} اول می‌آید."]},{"nl":"Ik had het druk.","fa":"سرم شلوغ بود.","notes":["{Het druk hebben} یعنی سرشلوغ بودن."]},{"nl":"Toen had ik nog geen werk.","fa":"آن موقع هنوز کار نداشتم.","notes":["{Toen} یعنی آن موقع. {Nog geen} یعنی هنوز هیچ."]}],"reading":[{"nl":"Toen ik klein was, hadden we een groot huis.","fa":"وقتی کوچک بودم، خانه بزرگی داشتیم."},{"nl":"We hadden een tuin en een hond.","fa":"باغچه و یک سگ داشتیم."},{"nl":"Mijn vader had een oude auto.","fa":"پدرم ماشین قدیمی داشت."},{"nl":"Ik had veel vrienden in de straat.","fa":"در کوچه دوستان زیادی داشتم."},{"nl":"We hadden geen geld, maar we hadden geluk.","fa":"پول نداشتیم، ولی خوشبخت بودیم."}],"readingAudio":"audio/r-052.mp3","recap":"گذشته {hebben}: {ik}/{jij}/{hij had}، {wij}/{jullie}/{zij hadden}."}